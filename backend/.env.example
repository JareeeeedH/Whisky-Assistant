DATABASE_URL=postgresql://whiskey:whiskey@localhost:5434/whiskey
# 到 https://platform.openai.com/api-keys 申請，貼在等號後面，不要加引號
OPENAI_API_KEY=
LLM_MODEL=gpt-6-luna
# 匯入與查詢必須用同一個模型；更換時要一併修改 db/schema.sql 的向量維度並重新匯入
EMBEDDING_MODEL=text-embedding-3-small
RERANK_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
# 只在部署時設定：允許呼叫 API 的前端網址，多個用逗號分隔；本機開發留空
CORS_ORIGINS=
RETRIEVAL_CANDIDATES=30
RETRIEVAL_TOP_K=3
